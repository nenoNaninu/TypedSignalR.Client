<Project>
    <!-- https://learn.microsoft.com/nuget/consume-packages/central-package-management -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="AspNetCore.SignalR.OpenTelemetry" Version="1.8.0" />
        <PackageVersion Include="TypedSignalR.Client" Version="3.7.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.33" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.33" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.33" />
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
        <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    </ItemGroup>
</Project>
